/junit-parallel.xml
/junit-serial.xml

# Generated test artifacts that must never be committed, and — since UAMS-Web/uams-statamic-archive#1889 — must
# never read as worktree drift either: the local-CI runner refuses a reused worktree
# whose `git status` is not clean, so an un-ignored artifact wedges every later run.
# `tests/.pest/` is Pest's profile directory (`--update-shards`); `mutate.log` is the
# `tee` target in ci.yml's mutation smoke. Neither is written by a plain gate run
# today, which is exactly why the rule belongs here before one is.
/tests/.pest/
/mutate.log

# Per-container Claude Code settings (ported from wordpress-importer#515)
.claude/settings.local.json

# Security-audit reports. The `security-audit` skill writes its finding-level report
# here, and that detail must stay out of the repository once it is public (UAMS-Web/uams-statamic-archive#2651),
# whether a finding is open or fixed (UAMS-Web/uams-statamic-archive#2733). Reports stay on the machine that ran
# the audit; the approved findings become `security` issues instead.
.claude/notes/

# Ephemeral worktrees the harness `EnterWorktree` tool creates. The stable slots
# in `.claude/rules/worktrees.md` are siblings of this checkout and never appear
# here, but the exception cases still land in this directory and must not be
# stageable. This lived only in `.git/info/exclude` — a per-machine, untracked
# file — so the rule's "can never be staged by construction" claim held on one
# machine and silently did not on the other supported platform.
.claude/worktrees/

# Tools fetched for a checkout that has no dev dependencies — a Claude Code cloud
# session cannot install them (`phpstan/phpstan` is dist-only, and one unsatisfiable
# package aborts the whole install), so `scripts/fetch-pint.mjs` puts Pint's prebuilt
# phar here over the git transport instead. Nothing it writes may ever be staged (UAMS-Web/uams-statamic-archive#1880).
/.tools/

# Python bytecode. The release-notes tests import `gen_release_notes.py`, and Python
# writes its cache beside whatever it imports. The tests set `PYTHONDONTWRITEBYTECODE`,
# so this covers running the generator or its tests by hand. Unanchored, because the
# cache lands beside the imported module wherever that is (UAMS-Web/uams-statamic-archive#2527).
__pycache__/
*.pyc
