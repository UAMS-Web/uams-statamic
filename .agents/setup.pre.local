#!/usr/bin/env bash
# This repository's own orb steps that its dependency installs need first (UAMS-Web/uams-statamic#1258).
# The shared .agents/setup, synced from UAMS-Web/uams-claude-skills, runs this file after it installs
# PHP 8.4, Composer 2 and Node 22, and before it runs `composer install` and `npm ci`. Steps that need
# the installed dependencies are in .agents/setup.local, which the shared script runs last. Step labels
# match the ones in the current .agents/setup.
set -euo pipefail

cd "$(dirname "${BASH_SOURCE[0]}")/.."
export DEBIAN_FRONTEND=noninteractive

step() {
    local label="$1" started=$SECONDS
    shift
    printf '\n==> %s\n' "$label"
    "$@"
    printf '==> %s completed in %ss\n' "$label" "$((SECONDS - started))"
}

# The shared script installs PHP 8.4 with curl, gd, intl, mbstring, sqlite3, xml, zip and pcov.
# composer.json requires imagick, so it must be present before `composer install`; bcmath is
# installed with it because several dependencies suggest it.
install_php_extras() {
    local packages=(xz-utils php8.4-bcmath php8.4-imagick)
    local missing=() package
    for package in "${packages[@]}"; do
        if ! dpkg-query -W -f='${Status}' "$package" 2>/dev/null | grep -qx 'install ok installed'; then
            missing+=("$package")
        fi
    done
    if ((${#missing[@]})); then
        # The shared script has already installed the sury.org keyring and source for PHP 8.4.
        sudo apt-get update -qq
        sudo env DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends "${missing[@]}"
    fi
    sudo tee /etc/php/8.4/cli/conf.d/99-orb.ini >/dev/null <<'INI'
memory_limit = -1
pcov.enabled = 0
zend.assertions = 1
pcre.jit = 0
INI
}

# The shared script installs Node 22, whose bundled npm is older than the `engines.npm` floor in
# package.json that `.npmrc`'s engine-strict enforces, so its `npm ci` would refuse to run.
install_npm_floor() {
    if ! node -e 'const [major, minor] = process.argv[1].split(".").map(Number); process.exit(major > 11 || major === 11 && minor >= 10 ? 0 : 1)' "$(npm --version)"; then
        sudo npm install --global 'npm@^11.10.0' --ignore-scripts
    fi
}

ensure_env_file() {
    [[ -f .env ]] || cp .env.example .env
}

# `php artisan key:generate` needs vendor/, which does not exist yet on a fresh orb, and the Composer
# scripts the shared install runs boot the application. This writes the same `base64:` key format.
ensure_app_key() {
    local key
    key=$(php -r 'echo "base64:", base64_encode(random_bytes(32));')
    if grep -q '^APP_KEY=' .env; then
        sed -i "s|^APP_KEY=.*|APP_KEY=$key|" .env
    else
        printf 'APP_KEY=%s\n' "$key" >> .env
    fi
}

# A plain `composer install` does not reapply a changed patch to vendor files a snapshot restored.
# This removes every package patched now or at the last install, so the shared install fetches
# fresh copies and applies the patches to them. setup.local records the inputs afterwards.
remove_repatched_packages() {
    local fingerprint patch_files=()
    # Hash only the local patches that exist: with none, an unmatched glob reaches sha256sum
    # as a literal path and set -e stops the setup.
    mapfile -t patch_files < <(compgen -G 'patches/*.patch' || true)
    fingerprint=$(sha256sum patches.lock.json "${patch_files[@]}" | sha256sum | cut -d ' ' -f 1)
    if [[ -d vendor && (! -f vendor/.orb-patch-inputs || "$(cat vendor/.orb-patch-inputs)" != "$fingerprint") ]]; then
        node --input-type=module <<'JS'
import { existsSync, readFileSync, rmSync } from 'node:fs';
for (const file of ['patches.lock.json', 'vendor/.orb-patches.lock.json']) {
    if (!existsSync(file)) continue;
    for (const name of Object.keys(JSON.parse(readFileSync(file, 'utf8')).patches)) {
        if (!/^[a-z0-9_.-]+\/[a-z0-9_.-]+$/i.test(name) || name.split('/').includes('..')) {
            throw new Error('Invalid patched package name');
        }
        rmSync(`vendor/${name}`, { recursive: true, force: true });
    }
}
JS
    fi
}

step 'PHP 8.4 and extensions' install_php_extras
step 'Node 22 and npm' install_npm_floor

# These collection definitions must exist before statamic:install can scaffold content.
step 'Test content submodules' git submodule update --init --depth 1 content users resources/forms
step 'Environment file' ensure_env_file
if ! grep -Eq '^APP_KEY=.+[^"[:space:]]' .env; then
    step 'Local application key' ensure_app_key
fi
step 'Locked PHP dependencies' remove_repatched_packages
printf '\nRepository steps before the dependency installs are done.\n'
