#!/usr/bin/env bash
# This repository's own orb setup steps (UAMS-Web/uams-statamic#1258). The shared .agents/setup,
# synced from UAMS-Web/uams-claude-skills, runs this file last; it installs PHP 8.4, Composer 2 and
# Node 22, then runs `composer install` and `npm ci`. Everything here is what that shared script
# does not do. Step labels match the ones in the current .agents/setup, and
# tests/Feature/Config/OrbLocalScriptsTest.php checks that every current step is placed.
set -euo pipefail

cd "$(dirname "${BASH_SOURCE[0]}")/.."
export DEBIAN_FRONTEND=noninteractive

step() {
    local label="$1" started=$SECONDS
    shift
    printf '\n==> %s\n' "$label"
    "$@"
    printf '==> %s completed in %ss\n' "$label" "$((SECONDS - started))"
}

# The shared script installs PHP 8.4 with curl, gd, intl, mbstring, sqlite3, xml, zip and pcov.
# This repository also needs bcmath and imagick, xz-utils for the Node archive, and its CLI ini.
install_php_extras() {
    local packages=(xz-utils php8.4-bcmath php8.4-imagick)
    local missing=() package
    for package in "${packages[@]}"; do
        if ! dpkg-query -W -f='${Status}' "$package" 2>/dev/null | grep -qx 'install ok installed'; then
            missing+=("$package")
        fi
    done
    if ((${#missing[@]})); then
        local codename source
        codename=$(. /etc/os-release && echo "$VERSION_CODENAME")
        source="deb [signed-by=/usr/share/keyrings/debsuryorg-archive-keyring.gpg] https://packages.sury.org/php/ $codename main"
        if [[ ! -f /usr/share/keyrings/debsuryorg-archive-keyring.gpg ]]; then
            local keyring
            keyring=$(mktemp --suffix=.deb)
            curl --fail --silent --show-error --location --retry 3 \
                https://packages.sury.org/debsuryorg-archive-keyring.deb -o "$keyring"
            sudo dpkg -i "$keyring"
            rm "$keyring"
        fi
        # Rewrite a source naming another release too: the image's own copy can name an older
        # one, and its packages then depend on libraries this release does not ship.
        if [[ $(cat /etc/apt/sources.list.d/php.list 2>/dev/null) != "$source" ]]; then
            echo "$source" | sudo tee /etc/apt/sources.list.d/php.list >/dev/null
        fi
        sudo apt-get update -qq
        sudo env DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends "${missing[@]}"
    fi
    sudo tee /etc/php/8.4/cli/conf.d/99-orb.ini >/dev/null <<'INI'
memory_limit = -1
pcov.enabled = 0
zend.assertions = 1
pcre.jit = 0
INI
}

# The shared script installs Node 22, whose bundled npm is older than the `engines.npm` floor in
# package.json that `.npmrc`'s engine-strict enforces.
install_npm_floor() {
    if ! node -e 'const [major, minor] = process.argv[1].split(".").map(Number); process.exit(major > 11 || major === 11 && minor >= 10 ? 0 : 1)' "$(npm --version)"; then
        sudo npm install --global 'npm@^11.10.0' --ignore-scripts
    fi
}

# The shared script runs a plain `composer install`, which does not reapply a changed patch to
# vendor files a snapshot restored. This removes every package patched now or at the last install
# and installs again, so the patches are applied to fresh copies.
install_php_dependencies() {
    local fingerprint patch_files=()
    # Hash only the local patches that exist: with none, an unmatched glob reaches sha256sum
    # as a literal path and set -e stops the setup.
    mapfile -t patch_files < <(compgen -G 'patches/*.patch' || true)
    fingerprint=$(sha256sum patches.lock.json "${patch_files[@]}" | sha256sum | cut -d ' ' -f 1)
    if [[ -d vendor && (! -f vendor/.orb-patch-inputs || "$(cat vendor/.orb-patch-inputs)" != "$fingerprint") ]]; then
        node --input-type=module <<'JS'
import { existsSync, readFileSync, rmSync } from 'node:fs';
for (const file of ['patches.lock.json', 'vendor/.orb-patches.lock.json']) {
    if (!existsSync(file)) continue;
    for (const name of Object.keys(JSON.parse(readFileSync(file, 'utf8')).patches)) {
        if (!/^[a-z0-9_.-]+\/[a-z0-9_.-]+$/i.test(name) || name.split('/').includes('..')) {
            throw new Error('Invalid patched package name');
        }
        rmSync(`vendor/${name}`, { recursive: true, force: true });
    }
}
JS
    fi
    composer install --no-scripts --no-interaction --no-progress --prefer-dist
    cp patches.lock.json vendor/.orb-patches.lock.json
    printf '%s\n' "$fingerprint" > vendor/.orb-patch-inputs
}

ensure_env_file() {
    [[ -f .env ]] || cp .env.example .env
}

ensure_sqlite_file() {
    [[ -f database/database.sqlite ]] || touch database/database.sqlite
}

step 'PHP 8.4 and extensions' install_php_extras
step 'Node 22 and npm' install_npm_floor

# These collection definitions must exist before statamic:install can scaffold content.
step 'Test content submodules' git submodule update --init --depth 1 content users resources/forms
step 'Environment file' ensure_env_file
step 'Locked PHP dependencies' install_php_dependencies
if ! grep -Eq '^APP_KEY=.+[^"[:space:]]' .env; then
    step 'Local application key' php artisan key:generate --no-interaction
fi
step 'Publish application assets' composer run-script post-autoload-dump --no-interaction
step 'SQLite database file' ensure_sqlite_file
step 'Local SQLite migrations' env APP_ENV=local DB_URL= DB_CONNECTION=sqlite \
    DB_DATABASE="$PWD/database/database.sqlite" \
    ASSET_METADATA_DATABASE="$PWD/storage/framework/cache/asset-metadata.sqlite" \
    php artisan migrate --force --no-interaction
step 'Browser test runtime' npx --no-install playwright install --with-deps chromium
step 'News release PDF browser' npx --no-install puppeteer browsers install chrome-headless-shell
step 'Front-end build' npm run build
step 'Control Panel build' npm run cp:build
step 'Test Stache snapshot' env DB_DATABASE=:memory: APP_ENV=testing php artisan test:seed-stache --no-interaction
printf '\nRepository-specific orb steps are done.\n'
