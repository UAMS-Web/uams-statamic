APP_NAME="UAMS Statamic"
APP_ENV=local
APP_KEY=""
APP_DEBUG=true
APP_TIMEZONE=UTC
STATAMIC_DISPLAY_TIMEZONE=America/Chicago
STATAMIC_CP_DEFAULT_TIMEZONE=${STATAMIC_DISPLAY_TIMEZONE}
APP_URL=http://uams-statamic.test

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
APP_MAINTENANCE_STORE=file # Variable unhidden by studio1902/statamic-peak

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# Optional: override path for asset metadata SQLite (YAML dual-write).
# PHPUnit sets this to :memory: in phpunit.xml for isolated tests.
# ASSET_METADATA_DATABASE=/absolute/path/to/asset-metadata.sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
# Encrypts session payloads at rest (Laravel's `EncryptCookies` middleware
# is separate and always on; this flag covers the *body* of the session
# data on disk / in the configured driver). Default left at false for local
# dev so file-based sessions stay readable; **set to true in production**
# — especially on shared hosts or multi-tenant infrastructure where the
# session driver writes to a location other processes can read.
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Sends the session cookie only over HTTPS (the cookie `Secure` flag). Left
# unset for local dev so HTTP dev servers keep their session. In production
# this is forced to true by App\Providers\SecurityDefaultsServiceProvider when
# left unset, so a forgotten env var fails safe — set it explicitly only to
# override that (e.g. `false` when TLS is terminated upstream in a way that
# needs it off).
# SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# `sync` runs jobs inline within the request — fine for local dev, but in
# PRODUCTION set a real driver (database/redis/managed) and run workers, or
# long-running jobs (PDF generation, form mail, static-cache + PubMed warming)
# block the request/scheduler. See docs/runbooks/production-queue.md.
QUEUE_CONNECTION=sync

CACHE_STORE=file
CACHE_PREFIX=

# Statamic {{ rss_feed }} tag: seconds to cache parsed external feed items (default 300).
# RSS_FEED_CACHE_TTL=300

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
# Laravel Herd (Pro): use the Redis port shown beside the service (often 6138),
# matching `redis-cli -p … ping` — `scripts/ensure-redis.sh` reads this for probes.
REDIS_PORT=6379

MAIL_MAILER=smtp # Variable changed by studio1902/statamic-peak
# MAIL_SCHEME=null # Variable hidden by studio1902/statamic-peak
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
# Mail transport encryption. Left null here so local Mailhog / Mailpit at
# 127.0.0.1:2525 keeps working out of the box (Mailhog doesn't speak TLS).
# **Production must use TLS or STARTTLS** — for SMTP set `MAIL_ENCRYPTION=tls`
# with `MAIL_PORT=587` (STARTTLS) or `MAIL_ENCRYPTION=ssl` with
# `MAIL_PORT=465` (implicit TLS); for SES the AWS SDK handles HTTPS
# transparently and this var can stay unset.
MAIL_ENCRYPTION=null # Variable added by studio1902/statamic-peak
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Form notification recipients (config/forms.php → forms.recipients.*). One
# address (or comma-separated list) per role — not per form. Placeholders only
# here; set the real mailbox in each environment before deploy. See
# docs/forms/notification-recipients.md (UAMS-Web/uams-statamic-archive#2745).
FORM_RECIPIENT_INSTITUTIONAL_RELATIONS=institutional-relations@example.test
FORM_RECIPIENT_MAIL_PROCESSING_CENTER=mail-processing@example.test
FORM_RECIPIENT_SPREAD_KINDNESS=spread-kindness@example.test
# A per-site key names the site first, and its config/forms.php entry is added
# with it. Placeholder shape, not a key any form names yet (UAMS-Web/uams-statamic-archive#3067):
# FORM_RECIPIENT_HEALTH_INSTITUTIONAL_RELATIONS=health-institutional-relations@example.test

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

STATAMIC_LICENSE_KEY=
STATAMIC_THEME=business
STATAMIC_PRO_ENABLED=true
STATAMIC_STACHE_WATCHER=auto
STATAMIC_STACHE_LOCK_ENABLED=true
STATAMIC_STATIC_CACHING_STRATEGY=null
STATAMIC_NOCACHE_DB_CONNECTION=mysql
STATAMIC_STATIC_WARM_QUEUE=null
STATAMIC_STATIC_WARM_QUEUE_CONNECTION=null
STATAMIC_STATIC_WARM_INSECURE=false
STATAMIC_CACHE_TAGS_ENABLED=false # Variable added by studio1902/statamic-peak
# Revisions hold a change to a published `people` entry as a working copy until an
# administrator publishes it (UAMS-Web/uams-statamic-archive#3184). Only `people` sets `revisions: true`. Working
# copies are stored under storage/statamic/revisions; see the README.
STATAMIC_REVISIONS_ENABLED=true
STATAMIC_GRAPHQL_ENABLED=false
# CP user impersonation. Disabled here so production never enables it
# implicitly; flip to true in local / staging when an admin needs to debug
# as another user. See config/statamic/users.php for the gating policy.
STATAMIC_IMPERSONATE_ENABLED=false
STATAMIC_API_ENABLED=false
# Statamic Content API auth token (config/statamic/api.php). Unset means the
# API is public: any *enabled* resource (config/statamic/api.php `resources`,
# all false by default) serves unauthenticated. In production,
# App\Providers\SecurityDefaultsServiceProvider disables the whole Content API
# when it is enabled with an enabled resource but no token here, so it fails
# closed rather than serve public data. Set a token before enabling a resource.
# STATAMIC_API_AUTH_TOKEN=
STATAMIC_GIT_ENABLED=true
STATAMIC_GIT_AUTOMATIC=false
STATAMIC_GIT_PUSH=false
STATAMIC_GIT_DISPATCH_DELAY=5 # Variable added by studio1902/statamic-peak
# Statamic `password` protection scheme (config/statamic/protect.php). Unset
# means the scheme blocks all access (fails closed). Set per environment
# when you actually need password-gated content, and rotate per CP-access
# policy.
# STATAMIC_PROTECT_PASSWORD=

IMAGE_MANIPULATION_DRIVER=imagick # Variable added by studio1902/statamic-peak

# Statamic "intensive operations" resource limits (image generation, console
# processes, view cascade, pcre.backtrack_limit for Antlers regex). Defaults
# are unlimited (-1 / 0) for local dev and the WordPress importer. Set caps
# in production to keep a runaway job from exhausting a shared host — see
# config/statamic/system.php for suggested values.
# STATAMIC_PHP_MEMORY_LIMIT=512M
# STATAMIC_PHP_MAX_EXECUTION_TIME=300
# STATAMIC_PCRE_BACKTRACK_LIMIT=10000000
# STATAMIC_AJAX_TIMEOUT=600000

#STATAMIC_CUSTOM_CMS_NAME= # Variable added (as hidden) by studio1902/statamic-peak
#STATAMIC_CUSTOM_LOGO_NAV_URL= # Variable added (as hidden) by studio1902/statamic-peak
#STATAMIC_CUSTOM_DARK_LOGO_URL= # Variable added (as hidden) by studio1902/statamic-peak
STATAMIC_CUSTOM_LOGO_OUTSIDE_URL="/visuals/statamic-peak-logo.svg" # Variable added by studio1902/statamic-peak
#STATAMIC_CUSTOM_FAVICON_URL= # Variable added (as hidden) by studio1902/statamic-peak
#STATAMIC_CUSTOM_CSS_URL= # Variable added (as hidden) by studio1902/statamic-peak

GOOGLE_MAPS_API_KEY=""

# Google Business Profile (Business Information API `categories.list`) — used to
# check the Google Business Profile category vocabulary (UAMS-Web/uams-statamic-archive#2616, UAMS-Web/uams-statamic-archive#2617). The
# refresh token is issued for the `business.manage` scope. Values come from the
# stored credentials and are never committed; leave these empty in the example.
GOOGLE_BUSINESS_PROFILE_CLIENT_ID=
GOOGLE_BUSINESS_PROFILE_CLIENT_SECRET=
GOOGLE_BUSINESS_PROFILE_REFRESH_TOKEN=

# NCBI asks every E-utilities client to identify itself so they can make contact
# before throttling or blocking it. PUBMED_CONTACT_EMAIL is REQUIRED: with none
# set, a PubMed lookup refuses rather than querying anonymously.
PUBMED_TOOL="uams-statamic" # Application name sent as `tool` on every E-utilities request
PUBMED_CONTACT_EMAIL="" # REQUIRED. Address NCBI can use to make contact; no lookup is sent without it
PUBMED_API_KEY="" # Optional. Raises the ceiling from 3 to 10 requests/second; omitted from the query when empty
PUBMED_API_CACHE_TTL=604800 # Cache time to live for PubMed API responses in seconds (604,800 seconds = 7 days)

US_CENSUS_BUREAU_API_KEY="" # https://www.census.gov/data/developers.html

# O*NET Web Services v2 (https://services.onetcenter.org/) — occupation title/description for CategoryCode JSON-LD
ONET_WEB_SERVICES_API_KEY=""
ONET_WEB_SERVICES_BASE_URL="https://api-v2.onetcenter.org"
ONET_WEB_SERVICES_CACHE_TTL=86400 # seconds — cache successful occupation overview responses per O*NET-SOC code
ONET_WEB_SERVICES_DELAY=0 # milliseconds to sleep before each HTTP request (0 disables); use to throttle when warming many codes
ONET_WEB_SERVICES_RATE_LIMIT_STORE=file # Laravel cache store for shared outbound rate limit (empty = disable limiter); use redis in production
ONET_WEB_SERVICES_MAX_REQUESTS_PER_SECOND=5 # O*NET ToS: max 5 requests per second per account — enforced via Redis-backed RateLimiter before each HTTP call

US_HUD_API_TOKEN="" # https://www.huduser.gov/portal/dataset/uspszip-api.html

DEBUGBAR_ENABLED=false

# Security headers (App\Http\Middleware\SecurityHeaders).
# Baseline headers (X-Content-Type-Options, Referrer-Policy, X-Frame-Options,
# Permissions-Policy) are applied to every response when enabled. CSP ships
# in Report-Only mode by default — flip SECURITY_CSP_REPORT_ONLY=false to enforce
# after observing real-world violation reports. HSTS only emits on HTTPS requests.
# CSP nonces: the middleware generates one per-request nonce and injects it into
# the directives listed in config/security-headers.php (csp.nonce_directives),
# exposing it to templates as {{ csp_nonce }}. style-src is nonce-gated (no
# 'unsafe-inline' for inline <style>); script-src still allows 'unsafe-inline'/
# 'unsafe-eval' pending the follow-ups noted in that config. No env var required.
SECURITY_HEADERS_ENABLED=true
SECURITY_CSP_ENABLED=true
SECURITY_CSP_REPORT_ONLY=true
# SECURITY_CSP_REPORT_URI=https://example.report-uri.com/r/d/csp/reportOnly
SECURITY_HSTS_ENABLED=false # Enable in production only — preload is sticky, opt in carefully
SECURITY_HSTS_MAX_AGE=31536000
SECURITY_HSTS_INCLUDE_SUBDOMAINS=true
SECURITY_HSTS_PRELOAD=false

# WordPress Import Settings
WORDPRESS_IMPORT_MEASURE_FILESIZE=true # Set to false to skip measuring directory filesize at start and end of import
WORDPRESS_IMPORT_IMAGES=true
WORDPRESS_IMPORT_FILES=true
WORDPRESS_IMPORT_SKIP_FAILED_ASSETS=false
WORDPRESS_IMPORT_ASSET_TIMEOUT=60
WORDPRESS_IMPORT_ASSET_RETRIES=3
WORDPRESS_IMPORT_TAGS=true

# WordPress Migration API — paging for `statamic:import:wordpress --source=api`.
# The address and the key are NOT configured: the importer asks for both when the
# command runs and stores neither (UAMS-Web/wordpress-importer#982). Only paging
# belongs here.
UAMSWP_MIGRATION_API_PER_PAGE=100

GITHUB_TOKEN=

SCHEMA_LD_PROFILE=false # set to true to log `compose_wall_ms` and uncached blueprint augment totals once per JSON-LD compose (see `laravel.log`)
SCHEMA_LD_PROFILE_TOP_N=10 # max per-request profile samples when profiling is enabled

# Gravity Forms notification import audit (the importer package's
# GravityFormsNotificationAuditTest). Optional. The audit ships its own synthetic
# fixtures and runs against them by default; point this at another directory
# carrying the same sample filenames (simple-contact.json,
# multi-notification.json) to audit that set instead. It is NOT a path to the
# wordpress-importer exports corpus — every file there is named
# gravityforms-export_<site>.json, so no sample resolves and the audit skips.
#GF_AUDIT_FIXTURES_DIR=/absolute/path/to/a/gravity-forms-sample-directory

# Formidable Forms notification import audit (the importer package's
# FormidableNotificationAuditTest and FormidableRealImportSpotCheckTest).
# Optional. Both run against that package's committed synthetic fixtures by
# default; point this at a local copy of the full wordpress-importer exports to
# audit the real-world corpus instead. The audit discovers its inputs by
# globbing *.xml, so any export directory works.
#FRM_AUDIT_FIXTURES_DIR=/absolute/path/to/wordpress-importer/src/Services/WordPressImport/Tests/Exports/FormidableForms

# Default position the GPS / map picker opens at (config/maps.php), used when a
# field sets no per-field default. Falls back to central Arkansas if unset.
#MAP_DEFAULT_LATITUDE=34.74828329990028
#MAP_DEFAULT_LONGITUDE=-92.32145208472011
#MAP_DEFAULT_ZOOM=14

# Map tiles for the GPS / map picker (config/maps.php).
# Defaults to the public OpenStreetMap tile server, which is fine for the
# low-volume Control Panel picker. A high-traffic public-facing map should
# point these at a dedicated tile provider or a self-hosted tile server (see
# switch2osm.org) — no code change needed. Attribution must always be shown
# per the OSM tile usage policy. Single-host URL (no `{s}` subdomains).
#MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
#MAP_TILE_ATTRIBUTION=&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors
#MAP_TILE_MAX_ZOOM=19
# Optional aerial/satellite layer (Street/Aerial toggle). Defaults to Esri World
# Imagery (no API key; Esri attribution shown when active). Set the URL empty to
# disable the toggle. Esri uses ArcGIS tile order ({z}/{y}/{x}), not XYZ.
#MAP_AERIAL_TILE_URL=https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}
#MAP_AERIAL_TILE_ATTRIBUTION=Tiles &copy; <a href="https://www.esri.com/">Esri</a>, Vantor, Earthstar Geographics, and the GIS User Community
# max_zoom caps how far you can zoom on aerial; max_native_zoom is the deepest
# level with real imagery (~19/30cm for the US) — past it Esri only upsamples.
#MAP_AERIAL_TILE_MAX_ZOOM=19
#MAP_AERIAL_TILE_MAX_NATIVE_ZOOM=19
# Front-end map viewer (the `partials/map` partial) — separate from the CP
# picker above so the public map can use a licensed provider while the CP stays
# on OSM. Provider-agnostic: the default `xyz` adapter renders any {z}/{x}/{y}
# raster service, so switching to MapTiler / Mapbox / Thunderforest / a
# self-hosted server is just a URL change (embed a keyed provider's key in the
# query string). Defaults to OSM, which the OSM tile policy reserves for
# low-volume use — point MAP_VIEWER_TILE_URL at a licensed/self-hosted provider
# for public traffic. Leave the URL empty to disable the map and fall back to
# the non-interactive link. `MAP_VIEWER_TILE_SUBDOMAINS` is only for `{s}` URLs.
#MAP_VIEWER_PROVIDER=xyz
#MAP_VIEWER_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
#MAP_VIEWER_TILE_ATTRIBUTION=&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors
#MAP_VIEWER_TILE_MAX_ZOOM=19
#MAP_VIEWER_TILE_SUBDOMAINS=
#MAP_VIEWER_DEFAULT_ZOOM=16
